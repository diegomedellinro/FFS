{%- assign ff_es = false -%}{%- if request.locale.iso_code == 'es' -%}{%- assign ff_es = true -%}{%- endif -%}
<div class="ff-why">
  <h3 class="ff-why__h">{% if ff_es %}Por qué comprarla{% else %}Why buy it{% endif %}</h3>
  <ul class="ff-why__list">
    <li>
      <span class="ff-why__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.3 6.8 19l1-5.8L3.5 9.2l5.9-.9z"/></svg></span>
      <span><b>{% if ff_es %}Tallas S a 4XL{% else %}Sizes S to 4XL{% endif %}</b>{% if ff_es %}Revisa la guía de tallas antes de comprar; si no te queda, te la cambiamos.{% else %}Check the size guide before you buy; if it doesn't fit, we exchange it.{% endif %}</span>
    </li>
    <li>
      <span class="ff-why__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.4 7.5L3 21l1.6-5.3A8.5 8.5 0 1 1 21 12z"/></svg></span>
      <span><b>{% if ff_es %}Soporte real{% else %}Real support{% endif %}</b>{% if ff_es %}Te respondemos por WhatsApp antes y después de tu compra.{% else %}We answer on WhatsApp before and after your purchase.{% endif %}</span>
    </li>
    <li>
      <span class="ff-why__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.8-3.4 8-8 9-4.6-1-8-4.2-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg></span>
      <span><b>{% if ff_es %}Compra protegida{% else %}Protected purchase{% endif %}</b>{% if ff_es %}30 días de garantía y envío gratis a México y +30 países.{% else %}30-day guarantee and free shipping to Mexico and 30+ countries.{% endif %}</span>
    </li>
  </ul>
</div>
<style>
  .ff-why{margin:2rem 0 0;padding:1.6rem 1.6rem 1.2rem;border:1px solid rgba(255,26,43,.55);background:rgba(255,26,43,.06);border-radius:4px}
  .ff-why__h{margin:0 0 1.2rem;font-size:1.6rem;text-transform:uppercase;letter-spacing:.1rem;color:#fff}
  .ff-why__list{list-style:none;margin:0;padding:0;display:grid;gap:1.2rem}
  .ff-why__list li{display:flex;gap:1.2rem;align-items:flex-start;font-size:1.35rem;line-height:1.4;color:#d8d8d8}
  .ff-why__list b{display:block;color:#fff;font-size:1.45rem;margin-bottom:.1rem}
  .ff-why__ic{flex:0 0 auto;display:grid;place-items:center;width:3.6rem;height:3.6rem;border-radius:50%;background:#ff1a2b;color:#fff}
</style>

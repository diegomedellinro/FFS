{%- assign ff_es = false -%}{%- if request.locale.iso_code == 'es' -%}{%- assign ff_es = true -%}{%- endif -%}
{%- if cart != empty -%}
  {%- liquid
    assign has_boots = false
    assign in_cart = ''
    for item in cart.items
      assign in_cart = in_cart | append: ',' | append: item.product_id | append: ','
      assign item_cols = item.product.collections | map: 'handle'
      if item_cols contains 'football-boots'
        assign has_boots = true
      endif
    endfor
    if has_boots
      assign source = collections['football-boots']
    else
      assign source = section.settings.collection
      if source == blank
        assign source = collections['mas-vendidas']
      endif
    endif
  -%}
<div class="ffr page-width" id="ffr-{{ section.id }}" data-lang="{% if ff_es %}es{% else %}en{% endif %}">
  <div class="ffr__keep">
    <a href="{{ routes.all_products_collection_url }}" class="ffr__back" data-back>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      {% if ff_es %}Seguir viendo{% else %}Keep browsing{% endif %}
    </a>
  </div>
  {%- if source != blank and source.products_count > 0 -%}
  <h2 class="ffr__h">
    {%- if has_boots -%}
      {% if ff_es %}Completa tu equipo: tacos más vendidos{% else %}Complete your kit: best-selling boots{% endif %}
    {%- else -%}
      {% if ff_es %}Las más vendidas{% else %}Best sellers{% endif %}
    {%- endif -%}
  </h2>
  <p class="ffr__sub">{% if ff_es %}Agrégala sin salir del carrito{% else %}Add it without leaving your cart{% endif %}</p>
  <div class="ffr__row" role="list">
    {%- assign shown = 0 -%}
    {%- for p in source.products limit: 40 -%}
      {%- if shown >= 8 -%}{%- break -%}{%- endif -%}
      {%- assign pid = ',' | append: p.id | append: ',' -%}
      {%- if in_cart contains pid or p.available == false -%}{%- continue -%}{%- endif -%}
      {%- assign p_cols = p.collections | map: 'handle' -%}
      {%- if has_boots == false and p_cols contains 'football-boots' -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <form class="ffr__card" role="listitem" data-add>
        <a href="{{ p.url }}" class="ffr__img">
          {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: p.title, widths: '200,300,400' }}{%- endif -%}
          {%- if p.compare_at_price > p.price -%}<span class="ffr__badge">-{{ p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price }}%</span>{%- endif -%}
        </a>
        <a href="{{ p.url }}" class="ffr__t">{{ p.title }}</a>
        <p class="ffr__price">{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s> {% endif %}{{ p.price | money }}</p>
        {%- if p.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
        {%- else -%}
          <label class="visually-hidden" for="ffr-v-{{ section.id }}-{{ p.id }}">{% if ff_es %}Talla{% else %}Size{% endif %}</label>
          <select name="id" id="ffr-v-{{ section.id }}-{{ p.id }}" class="ffr__sel">
            {%- for v in p.variants -%}{%- if v.available -%}<option value="{{ v.id }}">{{ v.title }}</option>{%- endif -%}{%- endfor -%}
          </select>
        {%- endif -%}
        <button type="submit" class="ffr__btn">{% if ff_es %}Agregar{% else %}Add{% endif %}</button>
      </form>
    {%- endfor -%}
  </div>
  {%- endif -%}
</div>
<style>
  .ffr{padding-top:10px;padding-bottom:18px}
  .ffr__keep{max-width:620px;margin:0 auto 26px;display:flex;justify-content:center}
  .ffr__back{display:inline-flex;align-items:center;gap:8px;padding:12px 26px;border:1.5px solid #fff;border-radius:999px;color:#fff;text-decoration:none;font-weight:700;font-size:1.4rem;transition:background .2s,color .2s}
  .ffr__back:hover{background:#fff;color:#000}
  .ffr__h{text-align:center;margin:0;font-size:2rem}
  .ffr__sub{text-align:center;margin:4px 0 16px;font-size:1.3rem;color:rgba(255,255,255,.6)}
  .ffr__row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(170px,1fr);gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;-webkit-overflow-scrolling:touch;scrollbar-width:thin}
  .ffr__card{scroll-snap-align:start;display:flex;flex-direction:column;gap:6px;background:#0d0d0d;border:1px solid rgba(255,255,255,.12);border-radius:6px;padding:10px;min-width:0}
  .ffr__img{position:relative;display:block;aspect-ratio:1;background:#fff;border-radius:4px;overflow:hidden}
  .ffr__img img{width:100%;height:100%;object-fit:contain;display:block}
  .ffr__badge{position:absolute;top:6px;left:6px;background:#ff1a2b;color:#fff;font-size:1.1rem;font-weight:800;padding:2px 6px;border-radius:3px}
  .ffr__t{color:#fff;text-decoration:none;font-size:1.25rem;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:3.3rem}
  .ffr__price{margin:0;font-size:1.35rem;font-weight:700;color:#fff}
  .ffr__price s{color:rgba(255,255,255,.5);font-weight:400;font-size:1.15rem}
  .ffr__sel{width:100%;background:#000;color:#fff;border:1px solid rgba(255,255,255,.3);border-radius:3px;padding:8px;font:inherit;font-size:1.25rem}
  .ffr__btn{margin-top:auto;width:100%;padding:10px;border:0;border-radius:3px;background:#ff1a2b;color:#fff;font:inherit;font-weight:700;font-size:1.3rem;cursor:pointer}
  .ffr__btn[disabled]{opacity:.6;cursor:wait}
  @media(min-width:990px){.ffr__row{grid-auto-columns:calc((100% - 42px)/4)}}
</style>
<script>
  (function(){
    var root=document.getElementById('ffr-{{ section.id }}');if(!root)return;
    var es=root.dataset.lang==='es';
    // "keep browsing" goes back to the exact page (and scroll position) the shopper came from
    var back=root.querySelector('[data-back]');
    // remember where they came from, so it survives the reload after adding a recommendation
    try{
      var ref=document.referrer?new URL(document.referrer):null,fromRef='';
      if(ref&&ref.origin===location.origin&&!/\/cart(\/|$|\?)/.test(ref.pathname)&&!/\/checkouts?\//.test(ref.pathname)){fromRef=ref.pathname+ref.search;sessionStorage.setItem('ffr_from',fromRef)}
      var from=fromRef||sessionStorage.getItem('ffr_from')||'';
      if(from){
        back.href=from;
        if(fromRef)back.addEventListener('click',function(e){if(history.length>1){e.preventDefault();history.back()}});
      }
    }catch(e){}
    root.querySelectorAll('[data-add]').forEach(function(f){
      f.addEventListener('submit',function(e){
        e.preventDefault();
        var btn=f.querySelector('.ffr__btn');btn.disabled=true;btn.textContent=es?'Agregando…':'Adding…';
        fetch('{{ routes.cart_add_url }}.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({items:[{id:parseInt(f.elements.id.value,10),quantity:1}]})})
          .then(function(r){if(!r.ok)throw r;return r.json()})
          .then(function(){location.reload()})
          .catch(function(){btn.disabled=false;btn.textContent=es?'Sin stock, elige otra talla':'Out of stock, pick another size'});
      });
    });
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Recomendados carrito",
  "settings": [
    {"type": "collection", "id": "collection", "label": "Colección de jerseys recomendadas", "info": "Si el carrito tiene tacos, se muestran tacos más vendidos"}
  ],
  "presets": [{"name": "Recomendados carrito"}]
}
{% endschema %}
